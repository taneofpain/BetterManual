<!DOCTYPE resources [
    <!ENTITY icon_lowerDial "\uE4CD">
    <!ENTITY icon_enterButton "\uEB01">
    <!ENTITY icon_top_right_dial "\uE519">
    ]>
<resources>
    <string name="app_name">BetterManual</string>
    <string name="view_aperture_navigation">&icon_top_right_dial; to change</string>
    <string name="view_iso_navigation_manual">&icon_top_right_dial; to change, &icon_enterButton; auto/manual</string>
    <string name="view_iso_navigation_auto">&icon_enterButton; auto/manual</string>
    <string name="view_shutter_navigation_enable">&icon_top_right_dial; to change</string>
    <string name="view_shutter_navigation_disabled">&icon_enterButton; to change MinShutterSpeed</string>
    <string name="view_drivemode_navigation">&icon_enterButton; to change</string>
    <string name="view_startBracket">&icon_enterButton; to start AE Bracket</string>
    <string name="view_startAFBracket">&icon_enterButton; to start AF Bracket</string>
    <string name="view_Timelapse">&icon_enterButton; to start Timelapse</string>
    <string name="view_ev">&icon_enterButton; to reset, &icon_top_right_dial; to change</string>

    <!-- Specific navigation hints, replacing generic "to change" text that
         didn't say what the control actually did. Matches the pattern
         Timelapse/AfBracket/Aperture/EV already used, extended to the rest
         of the vertical icon strip's controls. -->
    <string name="view_shutter_specific">&icon_top_right_dial; to change Shutter Speed</string>
    <string name="view_drivemode_specific">&icon_enterButton; to change Drive Mode</string>
    <string name="view_exposuremode_specific">&icon_enterButton; to change Exposure Mode</string>
    <string name="view_focusdrive_specific">&icon_enterButton; to change Focus Drive</string>
    <string name="view_longexponr_specific">&icon_enterButton; to toggle Long Exposure NR</string>
    <string name="view_imagestab_specific">&icon_enterButton; to toggle Image Stabilisation</string>
    <string name="view_aspectratioguide_specific">&icon_lowerDial; to change Aspect Ratio, &icon_enterButton; to confirm</string>
    <string name="view_aspectratioguidecolor_specific">&icon_lowerDial; to change Guide Line Color</string>
    <string name="view_legacylensname_specific">&icon_lowerDial; to select Lens, &icon_enterButton; to confirm</string>
    <string name="view_legacyfocal_specific">&icon_lowerDial; to change Focal Length, &icon_enterButton; to confirm</string>
    <string name="view_legacyspecial_specific">&icon_lowerDial; to select Special item, &icon_enterButton; to confirm</string>


    <string name="icon_lowerDial" translatable="false">&icon_lowerDial;</string>
    <string name="icon_enterButton" translatable="false">&icon_enterButton;</string>
    <string name="icon_top_right_dial" translatable="false">&icon_top_right_dial;</string>
</resources>
